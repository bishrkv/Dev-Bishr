rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio site configuration: publicly readable by visitors, updatable by admin
    match /portfolio_config/{docId} {
      allow read, write: if true;
    }

    // Contact messages: visitors can submit inquiries, admin can read and delete
    match /contact_messages/{messageId} {
      allow read, write, delete: if true;
    }
  }
}
